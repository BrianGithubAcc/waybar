{
  "layer": "bottom",
  "position": "top",
  "height": 34,
  "spacing": 0,
  "margin-top": 0,

  "modules-left": [
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "cpu",
    "memory",
    "network",
    "custom/battery",
    "tray"
  ],

  "clock": {
    "format": "{:%b %d %Y    %I:%M:%S %p}",
    "tooltip": false
  },

  "network": {
    "format-wifi": "󰤨 {signalStrength}% ",
    "format-ethernet": "󰈀Connected ",
    "format-disconnected": "󰤭 Offline "
  },

  "custom/battery": {
    "exec": "/home/brian/.config/waybar/scripts/battery_combined.sh",
    "interval": 5
  },

  "tray": {
    "spacing": 8
  }
}
